#ifndef QEV_CONFIG_H_
#define QEV_CONFIG_H_

/* Backend support flags */
#cmakedefine01 EV_USE_INOTIFY
#cmakedefine01 EV_USE_SIGNALFD
#cmakedefine01 EV_USE_EVENTFD
#cmakedefine01 EV_USE_TIMERFD
#cmakedefine01 EV_USE_SELECT
#cmakedefine01 EV_USE_EPOLL
#cmakedefine01 EV_USE_KQUEUE
#cmakedefine01 EV_USE_PORT
#cmakedefine01 EV_USE_POLL
#cmakedefine01 EV_USE_LINUXAIO
#cmakedefine01 EV_USE_IOURING
#cmakedefine01 EV_USE_WSAPOLL

/* Feature presence flags.
 *
 * PRIVATE to this library's own translation units. This header is PUBLIC -- qev.h needs the
 * EV_USE_* half above, and qev.h is reached by every consumer of <qb/io.h> through listener.h --
 * so before 3.0.0 these 35 unprefixed autoconf names, carrying qb's BUILD HOST's answers
 * (HAVE_POLL 1, HAVE_KQUEUE 1, HAVE_EPOLL_CTL 0, HAVE_EVENTFD 0, ...), reached every consumer
 * translation unit as well. A project that runs its own autoconf/CMake feature checks and tests
 * `#if HAVE_EPOLL_CTL` would read qb's answer instead of its own, silently and for the whole TU.
 *
 * Nothing outside qev.c needs them (grep: qev.h references only HAVE_CONFIG_H, the autotools
 * switch), so they are gated on QEV_BUILDING_LIBRARY, which the qev target sets PRIVATE. The
 * EV_USE_* half deliberately stays public and ungated: it is what keeps qev.h's view of the
 * backend identical to the compiled libqev.a's, and a split there is the silent divergence the
 * CMakeLists comment above the configure_file() call warns about.
 */
#ifdef QEV_BUILDING_LIBRARY
#cmakedefine01 HAVE_CLOCK_GETTIME
#cmakedefine01 HAVE_CLOCK_SYSCALL
#cmakedefine01 HAVE_DLFCN_H
#cmakedefine01 HAVE_EPOLL_CTL
#cmakedefine01 HAVE_EVENTFD
#cmakedefine01 HAVE_FLOOR
#cmakedefine01 HAVE_INOTIFY_INIT
#cmakedefine01 HAVE_INTTYPES_H
#cmakedefine01 HAVE_KQUEUE
#cmakedefine01 HAVE_LIBRT
#cmakedefine01 HAVE_LINUX_AIO_ABI_H
#cmakedefine01 HAVE_LINUX_FS_H
#cmakedefine01 HAVE_MEMORY_H
#cmakedefine01 HAVE_NANOSLEEP
#cmakedefine01 HAVE_POLL
#cmakedefine01 HAVE_POLL_H
#cmakedefine01 HAVE_PORT_CREATE
#cmakedefine01 HAVE_PORT_H
#cmakedefine01 HAVE_SELECT
#cmakedefine01 HAVE_SIGNALFD
#cmakedefine01 HAVE_STDINT_H
#cmakedefine01 HAVE_STDLIB_H
#cmakedefine01 HAVE_STRINGS_H
#cmakedefine01 HAVE_STRING_H
#cmakedefine01 HAVE_SYS_EPOLL_H
#cmakedefine01 HAVE_SYS_EVENTFD_H
#cmakedefine01 HAVE_SYS_EVENT_H
#cmakedefine01 HAVE_SYS_INOTIFY_H
#cmakedefine01 HAVE_SYS_SELECT_H
#cmakedefine01 HAVE_SYS_SIGNALFD_H
#cmakedefine01 HAVE_SYS_STAT_H
#cmakedefine01 HAVE_SYS_TIMERFD_H
#cmakedefine01 HAVE_SYS_TYPES_H
#cmakedefine01 HAVE_UNISTD_H
#cmakedefine01 HAVE_KERNEL_RWF_T
#endif /* QEV_BUILDING_LIBRARY */
/* Used to avoid wrong includes during codegen */
#cmakedefine01 EV_GENWRAP

#define EV_MULTIPLICITY 1
#define EV_FEATURES 0x7f

/* Project and version macros */
#define EV_PACKAGE "@PROJECT_NAME@"
#define EV_VERSION "@LIBEV_VERSION@"

#endif /* QEV_CONFIG_H_ */
