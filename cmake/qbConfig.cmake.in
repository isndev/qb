# -----------------------------------------------------------------------------
# qb Framework - Installed Configuration File
#
# This file is generated during installation and allows users to find and
# use the qb framework with find_package(qb).
# -----------------------------------------------------------------------------

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Set version information
set(QB_VERSION "@QB_FRAMEWORK_VERSION@")
set(QB_VERSION_MAJOR "@QB_FRAMEWORK_VERSION_MAJOR@")
set(QB_VERSION_MINOR "@QB_FRAMEWORK_VERSION_MINOR@")
set(QB_VERSION_PATCH "@QB_FRAMEWORK_VERSION_PATCH@")

# Installation prefix. Use the one @PACKAGE_INIT@ already computed correctly above rather than
# re-deriving it: this file is installed at <prefix>/lib/cmake/qb/, so walking up from
# CMAKE_CURRENT_LIST_FILE needs FOUR steps (file -> qb -> cmake -> lib -> prefix). It took three,
# landing on <prefix>/lib, so QB_INCLUDE_DIRS resolved to <prefix>/lib/include -- a directory that
# has never existed in any installed tree. Harmless for target-based consumers (they inherit the
# right path from qb::core / qb::io), silently wrong for anyone using the variable.
set(_IMPORT_PREFIX "${PACKAGE_PREFIX_DIR}")

# ---- Resolve transitive external dependencies ----
find_dependency(Threads)

if(@QB_HAS_SSL@)
    find_dependency(OpenSSL)
endif()

if(@QB_HAS_COMPRESSION@)
    find_dependency(ZLIB)
endif()

# qb::io's public headers expose nlohmann::json (qb::json is an alias for it). If qb was built
# against a system nlohmann_json rather than its bundled fallback, the consumer must resolve the
# SAME one -- qb did not install a copy, and using a different one would be an ODR violation on
# the type itself. Failing here at configure time is the loud, correct outcome.
if(@QB_USES_SYSTEM_NLOHMANN@)
    find_dependency(nlohmann_json 3.11)
endif()

if(@QB_HAS_ARGON2@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Argon2)
endif()

if(@QB_HAS_QUIC@)
    # qb::io was built against libngtcp2; recreate its imported targets so the
    # transitive (LINK_ONLY) link of qb::io resolves for find_package() consumers.
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Ngtcp2)
endif()

# Set include directories.
# One entry, because an installed qb has one include root. (The second entry this used to carry,
# "${_IMPORT_PREFIX}/include/modules", never existed in any installed tree -- no install rule has
# ever created it.) Consumers should link qb::core / qb::io and inherit this through the imported
# target; the variable is kept for legacy non-target usage and now actually points at it.
set(QB_INCLUDE_DIRS "${_IMPORT_PREFIX}/include")

# Available components
set(_QB_AVAILABLE_COMPONENTS core io)

# Default to all components if none specified
if(NOT qb_FIND_COMPONENTS)
    set(qb_FIND_COMPONENTS ${_QB_AVAILABLE_COMPONENTS})
endif()

# Component dependency mapping
set(_QB_core_DEPENDS io)
set(_QB_io_DEPENDS "")

# Function to resolve component dependencies
function(_qb_resolve_component_deps component result_var)
    set(_deps ${_QB_${component}_DEPENDS})
    set(_all_deps ${_deps})
    
    foreach(_dep ${_deps})
        _qb_resolve_component_deps(${_dep} _recursive_deps)
        list(APPEND _all_deps ${_recursive_deps})
    endforeach()
    
    if(_all_deps)
        list(REMOVE_DUPLICATES _all_deps)
    endif()
    
    set(${result_var} ${_all_deps} PARENT_SCOPE)
endfunction()

# Process requested components and their dependencies
set(_QB_COMPONENTS_TO_LOAD)
foreach(_comp ${qb_FIND_COMPONENTS})
    list(APPEND _QB_COMPONENTS_TO_LOAD ${_comp})
    _qb_resolve_component_deps(${_comp} _comp_deps)
    list(APPEND _QB_COMPONENTS_TO_LOAD ${_comp_deps})
endforeach()

if(_QB_COMPONENTS_TO_LOAD)
    list(REMOVE_DUPLICATES _QB_COMPONENTS_TO_LOAD)
endif()

# Load the exported targets (generated by install(EXPORT qbTargets ...))
set(_qb_targets_file "${CMAKE_CURRENT_LIST_DIR}/qbTargets.cmake")
if(EXISTS "${_qb_targets_file}")
    include("${_qb_targets_file}")
endif()

# Check requested components against the available targets
foreach(_comp ${_QB_COMPONENTS_TO_LOAD})
    if(TARGET qb::${_comp})
        set(QB_${_comp}_FOUND TRUE)
        set(qb_${_comp}_FOUND TRUE)
    else()
        set(QB_${_comp}_FOUND FALSE)
        set(qb_${_comp}_FOUND FALSE)
        
        if(qb_FIND_REQUIRED_${_comp})
            message(FATAL_ERROR "Required qb component '${_comp}' not found")
        endif()
    endif()
endforeach()

# Set convenience variables
set(QB_LIBRARIES)
set(QB_TARGETS)

if(TARGET qb::core)
    list(APPEND QB_LIBRARIES qb::core)
    list(APPEND QB_TARGETS qb::core)
    set(QB_CORE_TARGET qb::core)
endif()

if(TARGET qb::io)
    list(APPEND QB_LIBRARIES qb::io)
    list(APPEND QB_TARGETS qb::io)
    set(QB_IO_TARGET qb::io)
endif()

# Check if all required components were found
set(_QB_REQUIRED_COMPONENTS_FOUND TRUE)
foreach(_comp ${qb_FIND_COMPONENTS})
    if(qb_FIND_REQUIRED_${_comp} AND NOT QB_${_comp}_FOUND)
        set(_QB_REQUIRED_COMPONENTS_FOUND FALSE)
        break()
    endif()
endforeach()

# Set main found variable
if(_QB_REQUIRED_COMPONENTS_FOUND)
    set(QB_FOUND TRUE)
    set(qb_FOUND TRUE)
else()
    set(QB_FOUND FALSE)
    set(qb_FOUND FALSE)
endif()

# Feature information (set during build)
set(QB_HAS_SSL @QB_HAS_SSL@)
set(QB_HAS_COMPRESSION @QB_HAS_COMPRESSION@)
set(QB_HAS_ARGON2 @QB_HAS_ARGON2@)
set(QB_HAS_QUIC @QB_HAS_QUIC@)

# Public-type ABI token -- which implementation qb::unordered_map / qb::unordered_set resolve
# to in THIS qb. See the long note in cmake/qbConfig.cmake: it exists so that a public type
# whose identity is picked by a build macro fails at configure time rather than at run time.
# qbmModuleConfig.cmake.in compares it against the value a prebuilt module recorded.
set(QB_ABI_UNORDERED_MAP "@QB_ABI_UNORDERED_MAP@")

# Clean up internal variables
unset(_IMPORT_PREFIX)
unset(_QB_AVAILABLE_COMPONENTS)
unset(_QB_COMPONENTS_TO_LOAD)
unset(_QB_REQUIRED_COMPONENTS_FOUND)
unset(_qb_targets_file)