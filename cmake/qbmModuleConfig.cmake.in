# -----------------------------------------------------------------------------
# qbm module - Installed Configuration File (generated per module)
#
# Generated by qb_install_package() in qbPackage.cmake -- the same call qb makes for
# itself with qbConfig.cmake.in -- one instance per module, so that:
#
#     find_package(qbm-@_QBM_CFG_NAME@ CONFIG REQUIRED)
#     target_link_libraries(app PRIVATE qbm::@_QBM_CFG_NAME@)
#
# is the whole consumer contract. In particular the consumer does NOT have to know
# that this module needs qb -- find_dependency(qb) below is the point of the file.
# -----------------------------------------------------------------------------

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(QBM_@_QBM_CFG_NAME_UPPER@_VERSION "@_QBM_CFG_VERSION@")
set(QBM_@_QBM_CFG_NAME_UPPER@_MODULE_NAME "@_QBM_CFG_NAME@")

# The qb build this module's binaries were actually compiled against.
set(QBM_@_QBM_CFG_NAME_UPPER@_QB_VERSION "@QB_FRAMEWORK_VERSION@")
set(QBM_@_QBM_CFG_NAME_UPPER@_QB_HAS_SSL "@QB_HAS_SSL@")
set(QBM_@_QBM_CFG_NAME_UPPER@_QB_HAS_QUIC "@QB_HAS_QUIC@")
set(QBM_@_QBM_CFG_NAME_UPPER@_QB_HAS_COMPRESSION "@QB_HAS_COMPRESSION@")

# Our own directory goes on the module path for the duration of this file only, so the
# Find*.cmake modules shipped beside it resolve without leaking a search path into the
# consumer's project for the rest of the configure run.
set(_qbm_saved_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# ---- qb -----------------------------------------------------------------------------
# Loose bound on the SEARCH (qb's own ConfigVersion is SameMajorVersion) so that qb is
# located at all and QB_VERSION / QB_HAS_* become readable; the exact coherence gate is
# the block below. find_dependency() returns from this file on failure, which is what
# makes the consumer's find_package(qbm-@_QBM_CFG_NAME@ REQUIRED) fail loudly and early.
# find_dependency() RETURNS from this file when qb is absent -- which is the loud early failure we
# want, but it also skips the CMAKE_MODULE_PATH restore at the bottom. Without the guard below, a
# consumer whose prefix has no qb keeps <prefix>/lib/cmake/qbm-<mod> on CMAKE_MODULE_PATH for the
# rest of its configure, so a later unrelated find_package(Nghttp3) silently resolves through the
# Find module this package ships. Restore before returning; the skew paths below already do.
if(NOT qb_FOUND)
    find_package(qb @QB_FRAMEWORK_VERSION_MAJOR@.@QB_FRAMEWORK_VERSION_MINOR@ QUIET)
    if(NOT qb_FOUND)
        set(CMAKE_MODULE_PATH "${_qbm_saved_module_path}")
    endif()
endif()
find_dependency(qb @QB_FRAMEWORK_VERSION_MAJOR@.@QB_FRAMEWORK_VERSION_MINOR@)

# ---- coherence gate -----------------------------------------------------------------
# Two skews break a consumer of a PREBUILT module archive, and a version range catches
# neither on its own:
#
#   1. version skew  -- qb's public surface is inline- and template-heavy, so this
#      archive is only valid against the exact qb it was compiled with. Under qb's
#      SameMajorVersion policy, find_dependency(qb 2.6) happily accepts qb 2.9.
#   2. feature skew  -- this module's public headers are #ifdef-gated on qb's PUBLIC
#      QB_HAS_SSL / QB_HAS_QUIC. If the installed qb disagrees with the qb that produced
#      the archive, the consumer's translation unit parses a DIFFERENT header than the
#      one that was compiled, and the symptom is an unresolved symbol at link time (or
#      worse, a silent ABI mismatch).
#
# Reported through <pkg>_FOUND + <pkg>_NOT_FOUND_MESSAGE rather than a bare FATAL_ERROR,
# so a REQUIRED consumer still gets a hard stop naming both sides while an optional
# find_package(... QUIET) degrades instead of aborting the configure.
set(_qbm_skew "")

if(NOT QB_VERSION VERSION_EQUAL QBM_@_QBM_CFG_NAME_UPPER@_QB_VERSION)
    string(APPEND _qbm_skew
        " qbm-@_QBM_CFG_NAME@ @_QBM_CFG_VERSION@ was built against qb "
        "${QBM_@_QBM_CFG_NAME_UPPER@_QB_VERSION}, but the qb found here is ${QB_VERSION}.")
endif()

foreach(_qbm_feat SSL QUIC COMPRESSION)
    set(_qbm_now 0)
    if(QB_HAS_${_qbm_feat})
        set(_qbm_now 1)
    endif()
    set(_qbm_then 0)
    if(QBM_@_QBM_CFG_NAME_UPPER@_QB_HAS_${_qbm_feat})
        set(_qbm_then 1)
    endif()
    if(NOT _qbm_now EQUAL _qbm_then)
        string(APPEND _qbm_skew
            " qbm-@_QBM_CFG_NAME@ was built with QB_HAS_${_qbm_feat}=${_qbm_then}, but the qb "
            "found here reports QB_HAS_${_qbm_feat}=${_qbm_now}; this module's public headers "
            "are gated on that macro.")
    endif()
    unset(_qbm_now)
    unset(_qbm_then)
endforeach()
unset(_qbm_feat)

if(_qbm_skew)
    set(CMAKE_MODULE_PATH "${_qbm_saved_module_path}")
    # One string, not two arguments: set(VAR "a" "b") builds a LIST, and the ";" separator
    # then shows up in the middle of the message CMake prints back to the user.
    string(CONCAT _qbm_msg
        "incompatible qb installation.${_qbm_skew}"
        " Rebuild the module against this qb, or point CMAKE_PREFIX_PATH at the matching one.")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "${_qbm_msg}")
    unset(_qbm_msg)
    unset(_qbm_skew)
    unset(_qbm_saved_module_path)
    return()
endif()

unset(_qbm_skew)

# ---- module-supplied dependency recreation (optional) --------------------------------
# CMake exports ad-hoc IMPORTED targets (e.g. one built from pkg_check_modules in the
# module's own directory scope) into INTERFACE_LINK_LIBRARIES BY NAME, with no error and
# no recreation. A consumer has no way to invent them, so the module ships a file that
# does -- included BEFORE the targets file, which references those names.
set(_qbm_deps_file "${CMAKE_CURRENT_LIST_DIR}/@_QBM_CFG_PKG@Dependencies.cmake")
if(EXISTS "${_qbm_deps_file}")
    include("${_qbm_deps_file}")
endif()
unset(_qbm_deps_file)

# ---- targets -------------------------------------------------------------------------
include("${CMAKE_CURRENT_LIST_DIR}/@_QBM_CFG_PKG@Targets.cmake")

set(CMAKE_MODULE_PATH "${_qbm_saved_module_path}")
unset(_qbm_saved_module_path)

if(NOT TARGET qbm::@_QBM_CFG_NAME@)
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "@_QBM_CFG_PKG@Targets.cmake did not define qbm::@_QBM_CFG_NAME@.")
    return()
endif()

set(QBM_@_QBM_CFG_NAME_UPPER@_LIBRARIES qbm::@_QBM_CFG_NAME@)
set(QBM_@_QBM_CFG_NAME_UPPER@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@_QBM_CFG_INCDIR@")
